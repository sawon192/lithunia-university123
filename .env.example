# ─────────────────────────────────────────────────────────────────────────────
# GO ABROAD BD — environment variables
# Copy to .env.local for development. Never commit the real file.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Bypasses RLS — never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Signs the staff session cookie. Required in production.
# Generate with: openssl rand -base64 48
ADMIN_SESSION_SECRET=

# Salt used to hash submitting IP addresses for abuse detection (never stores raw IPs)
RATE_LIMIT_SALT=

# ── Local development only ───────────────────────────────────────────────────
# Enables /admin sign-in before Supabase Auth is configured.
# Leave both blank on Vercel.
ADMIN_EMAIL=
ADMIN_PASSWORD=
